{
    "name": "x-fran/g-trends",
    "type": "library",
    "description": "Google Trends API for PHP",
    "authors": [
        {
            "name": "TarLabs.",
            "email": "francisc@tarlabs.es",
            "role": "Founder"
        }
    ],
    "homepage": "https://tarlabs.es/",
    "keywords": [
        "google",
        "google-trends",
        "google-api",
        "trends",
        "explore",
        "trending",
        "related-queries",
        "trending-search",
        "php-library",
        "php"
    ],
    "support": {
        "email": "francisc.tar@gmail.com"
    },
    "license": [
        "MIT"
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "process-timeout": 5000,
        "sort-packages": true
    },
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-simplexml": "*",
        "laminas/laminas-http": "^2.23",
        "laminas/laminas-stdlib": "^3.21"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^12.5",
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "^4.0",
        "vimeo/psalm": "^6.17"
    },
    "autoload": {
        "psr-4": {
            "XFran\\GTrends\\": "src/GTrends"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "XFran\\GTrends\\": "test/GTrends"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "stan": "phpstan analyse",
        "psalm": "psalm",
        "md": "phpmd src text cleancode,codesize,design",
        "check": [
            "@cs-check",
            "@stan",
            "@psalm",
            "@test"
        ]
    }
}
